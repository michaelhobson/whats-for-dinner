# PostgreSQL connection string — set this in Vercel's environment variables
# and in a local .env file for development (never commit the real value)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared household passcode — required to access any page of the app
# Set the same value in Vercel's environment variables
PASSCODE=your-household-passcode

# Anthropic API key — used for:
#   1. Fallback ingredient parsing during URL import (ambiguous lines without a
#      recognizable leading quantity fall back to storing the full string if unset)
#   2. Photo import: vision extraction of recipe name, ingredients, and directions
#      from an uploaded image (photo import is unavailable if this is unset)
ANTHROPIC_API_KEY=sk-ant-...
