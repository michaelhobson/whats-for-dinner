# PostgreSQL connection string — set this in Vercel's environment variables
# and in a local .env file for development (never commit the real value)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth.js secret — used to sign session tokens and CSRF tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Resend API key — used to send magic-link sign-in emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_...

# The "from" address for sign-in emails. Must be a domain verified in Resend.
RESEND_FROM=noreply@yourdomain.com

# Comma-separated list of email addresses that should be added to the founding
# Kitchen (the one created by prisma/migrate-kitchen.ts) on first sign-in.
# Everyone else automatically gets their own personal Kitchen.
# Example: FOUNDING_KITCHEN_MEMBER_EMAILS=alice@example.com,bob@example.com
FOUNDING_KITCHEN_MEMBER_EMAILS=

# Anthropic API key — used for:
#   1. Fallback ingredient parsing during URL import (ambiguous lines without a
#      recognizable leading quantity fall back to storing the full string if unset)
#   2. Photo import: vision extraction of recipe name, ingredients, and directions
#      from an uploaded image (photo import is unavailable if this is unset)
ANTHROPIC_API_KEY=sk-ant-...
