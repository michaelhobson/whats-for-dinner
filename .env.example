# Copy this file to .env for local development. On Vercel, set the same
# variables in the project's environment settings. Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local development must point at a LOCAL database (e.g. localhost). Keep the
# production URL out of your local .env so migrations, seeds, and scripts can
# never touch production by accident.
DATABASE_URL=postgresql://user:password@localhost:5432/whats_for_dinner

# Auth.js secret — used to sign session tokens and CSRF tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Resend API key — used to send magic-link sign-in emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_...

# The "from" address for sign-in emails. Must be on a domain verified in Resend.
RESEND_FROM=noreply@yourdomain.com

# ── Optional ────────────────────────────────────────────────────────────────

# Comma-separated list of email addresses that should be added to the founding
# Kitchen (the one created by prisma/migrate-kitchen.ts) on first sign-in.
# Only needed when migrating an existing single-household database; everyone
# else automatically gets their own personal Kitchen. Leave blank otherwise.
# Example: FOUNDING_KITCHEN_MEMBER_EMAILS=alice@example.com,bob@example.com
FOUNDING_KITCHEN_MEMBER_EMAILS=

# Anthropic API key — used for:
#   1. Fallback ingredient parsing during URL import (ambiguous lines without a
#      recognizable leading quantity are stored as the full string if unset)
#   2. Photo import: vision extraction of recipe name, ingredients, and
#      directions from uploaded images (photo import is unavailable if unset)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
