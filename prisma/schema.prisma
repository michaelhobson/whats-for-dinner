generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Difficulty {
  easy
  medium
  hard
}

model Recipe {
  id            Int        @id @default(autoincrement())
  name          String

  // Optional primary components (used as filter axes)
  mainProtein   String?
  mainStarch    String?
  mainVegetable String?

  // JSON-encoded [{name: string, quantity?: string}]
  ingredients   String

  favorite      Boolean    @default(false)

  // Single-value descriptors
  dishCategory  String?
  difficulty    Difficulty
  prepTime      Int        // estimated total minutes

  // Multi-value fields: comma-separated strings.
  // Valid tokens per field:
  //   mealType     — breakfast | lunch | dinner | dessert | snack
  //   cuisine      — region strings, max 2 (e.g. "East Asian,Mediterranean")
  //   flavorNotes  — free-form (e.g. "rich,umami,cheesy")
  //   season       — spring | summer | fall | winter | any
  //   cookingMethod — oven | stovetop | instant-pot | slow-cooker | grill | no-cook | air-fryer
  mealType      String
  cuisine       String
  flavorNotes   String
  season        String
  cookingMethod String

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
