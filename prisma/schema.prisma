generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js required models ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships KitchenMembership[]

  // The kitchen this user lands on after login. Nullable so no migration is
  // needed for existing users; falls back to oldest membership in getKitchenId().
  defaultKitchenId Int?
  defaultKitchen   Kitchen?        @relation("UserDefaultKitchen", fields: [defaultKitchenId], references: [id], onDelete: SetNull)
  sentInvites      KitchenInvite[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// Session model required by @auth/prisma-adapter even when using JWT strategy.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Kitchen / membership models ────────────────────────────────────────────────

enum KitchenRole {
  RESTAURATEUR // owner-level: can add/edit/delete recipes
  CHEF         // can add/edit recipes
  DINER        // read-only
}

// A Kitchen is the unit that owns recipes.
model Kitchen {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  recipes          Recipe[]
  memberships      KitchenMembership[]
  defaultForUsers  User[]              @relation("UserDefaultKitchen")
  invites          KitchenInvite[]
}

// Join table linking Users to Kitchens with a role.
model KitchenMembership {
  userId    String
  kitchenId Int
  role      KitchenRole @default(RESTAURATEUR)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchen Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  @@id([userId, kitchenId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model KitchenInvite {
  id              Int          @id @default(autoincrement())
  kitchenId       Int
  invitedEmail    String
  role            KitchenRole
  token           String       @unique
  status          InviteStatus @default(PENDING)
  invitedByUserId String
  createdAt       DateTime     @default(now())
  expiresAt       DateTime

  kitchen   Kitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  invitedBy User    @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
}

// ── App models ─────────────────────────────────────────────────────────────────

enum Difficulty {
  easy
  medium
  hard
}

model Recipe {
  id            Int        @id @default(autoincrement())
  name          String

  // Optional primary components (used as filter axes)
  mainProtein   String?
  mainStarch    String?
  mainVegetable String?

  // JSON-encoded [{name, amount?, unit?}]
  ingredients   String
  // JSON-encoded string[] (ordered steps)
  directions    String     @default("[]")

  favorite      Boolean    @default(false)

  // Single-value descriptors
  dishCategory  String?
  difficulty    Difficulty
  prepTime      Int        // estimated total minutes

  // Multi-value fields: comma-separated strings
  mealType      String
  cuisine       String     // JSON: [{region, style}] — up to 2 pairings
  flavorNotes   String
  season        String
  cookingMethod String

  // Rating: "up" | "down" — null means not yet rated
  rating        String?
  // Free-text notes (e.g. "use less salt next time")
  notes         String?

  // Provenance — populated by URL import; forkedFromRecipeId reserved for future cross-kitchen sharing
  sourceUrl          String?
  forkedFromRecipeId Int?
  forkedFrom         Recipe?    @relation("RecipeForks", fields: [forkedFromRecipeId], references: [id])
  forks              Recipe[]   @relation("RecipeForks")

  // Kitchen ownership — nullable to allow a two-step migration (add column,
  // then run prisma/migrate-kitchen.ts to backfill, then make required in a later migration)
  kitchenId Int?
  kitchen   Kitchen? @relation(fields: [kitchenId], references: [id])

  cookHistory   CookLog[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model CookLog {
  id        Int      @id @default(autoincrement())
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedAt  DateTime @default(now())
}
